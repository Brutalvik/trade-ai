# Copy this file to .env and fill in your keys. Never commit .env.
ANTHROPIC_API_KEY=
# ChatGPT is off by default. To use it as a second opinion, set both:
# ENABLE_OPENAI=true
# OPENAI_API_KEY=
# Optional overrides
CLAUDE_MODEL=claude-opus-5-5
# OPENAI_MODEL=gpt-5
PORT=8787
# Optional backup for candles when GeckoTerminal rate-limits (free demo key at coingecko.com/en/api)
# COINGECKO_API_KEY=
# COINGECKO_PLAN=demo
